# Sao chép file này thành .env.docker. Không commit .env.docker lên Git.
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://192.168.101.128

DB_HOST=mysql
DB_PORT=3306
DB_USER=vccorp_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=vccorp_db
DB_LOGGING=false
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_NAME=vccorp_access_token
AUTH_COOKIE_MAX_AGE_SECONDS=900
AUTH_REFRESH_COOKIE_NAME=vccorp_refresh_token
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
BCRYPT_SALT_ROUNDS=10

OTP_EXPIRES_IN_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-your-gmail-address
SMTP_APP_PASSWORD=replace-with-your-gmail-app-password
SMTP_FROM=replace-with-your-gmail-address

CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret
CLOUDINARY_FOLDER=vccorp-blog

REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_DB=0
REDIS_KEY_PREFIX=vccorp:
