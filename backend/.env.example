# =============================================================
# Biến môi trường - VCCorp Backend (NestJS)
# Copy file này thành .env và điền thông tin phù hợp
# =============================================================

# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Database - MySQL (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vccorp_db
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1h

# HttpOnly authentication cookie
AUTH_COOKIE_NAME=vccorp_access_token
AUTH_COOKIE_MAX_AGE_SECONDS=3600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

# Bcrypt
BCRYPT_SALT_ROUNDS=10
OTP_EXPIRES_IN_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Gmail SMTP - use a Google App Password, never your normal Gmail password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password
SMTP_FROM=VCCorp Blog <your-account@gmail.com>

# Cloudinary - database stores secure_url only
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vccorp-blog
