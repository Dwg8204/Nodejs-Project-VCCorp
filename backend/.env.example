# =============================================================
# Biến môi trường - VCCorp Backend (NestJS)
# Copy file này thành .env và điền thông tin phù hợp
# =============================================================

# Server
NODE_ENV=development
PORT=3000

# Database - MySQL (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vccorp_db
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=10
